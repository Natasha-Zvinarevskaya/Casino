@{
    ViewData["Title"] = "Blackjack Multiplayer";
}

<link rel="stylesheet" href="~/css/style.css" />

<div class="container">

    <h2 class="title">Blackjack – Multiplayer</h2>

    <div class="conn">
        WebSocket: <span id="connState">connecting...</span>
    </div>

    <!-- GAME LOG (для событий: кто вошёл, кто вышел, кто взял карту, кто пропустил) -->
    <div class="section card">
        <h3>События игры</h3>
        <div id="gameLog" class="log-box"></div>
    </div>

    <!-- GAME CREATION SECTION -->
    <div id="betSection" class="section card">
        <h3>Создать игру</h3>

        <label>Ставка</label>
        <select id="betSelect" class="input">
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>

        <label>Максимум игроков</label>
        <input id="maxPlayers" type="number" class="input" min="1" max="10" value="2">

        <button id="startBtn" class="btn full">Создать игру</button>
    </div>

    <!-- CONNECT / DISCONNECT -->
    <div class="section card">
        <h3>Подключение</h3>

        <div>ID игры: <span id="currentGameId">—</span></div>

        <button id="connectBtn" class="btn">Подключиться</button>
        <button id="disconnectBtn" class="btn">Отключиться</button>
    </div>

    <!-- GAME AREA -->
    <div id="gameArea" class="section card">

        <h3>Стол дилера</h3>
        <div id="dealerCards" class="cards-row"></div>

        <h3>Игроки</h3>
        <div id="playerCards" class="players-grid"></div>

        <div class="actions">
            <button id="hitBtn" class="btn action">Взять карту</button>
            <button id="standBtn" class="btn action">Пропустить ход</button>
            <button id="newGameBtn" class="btn">Новая игра</button>
        </div>
    </div>

</div>

<!-- MODAL -->
<div id="modal" class="modal">
    <div class="modal-content">
        <h2 id="modalMessage"></h2>
        <p id="modalSub"></p>

        <button id="modalRestart" class="btn full">Ок</button>
    </div>
</div>

<!-- TOAST -->
<div id="toast" class="toast"></div>

<script src="~/js/script.js"></script>
